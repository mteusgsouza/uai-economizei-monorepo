# Payload + Vercel: a estrutura symlinkada do pnpm quebra o empacotamento das
# funções serverless (binários nativos como o libvips do sharp caem em
# diretórios symlinkados). node-linker=hoisted usa um node_modules plano, sem
# symlinks — recomendação oficial do Payload para pnpm.
node-linker=hoisted
