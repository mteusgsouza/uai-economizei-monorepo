# Postgres (Neon) — pedidos, clientes e push subscriptions
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (upload)
BLOB_READ_WRITE_TOKEN=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_CUSTOMER_SECRET=
JWT_CUSTOMER_ACCESS_EXPIRY=15m
JWT_CUSTOMER_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/customer/google/callback

# Firebase Admin (JSON completo da service account)
FIREBASE_SERVICE_ACCOUNT=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# REST do Payload (server-to-server; ex.: http://localhost:3000/api)
PAYLOAD_API_URL=http://localhost:3000/api

# Chave interna compartilhada com o admin do Payload (rotacionável)
INTERNAL_API_KEY=
