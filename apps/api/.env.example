# Postgres (Neon) — pedidos, clientes e push subscriptions.
# Use sslmode=verify-full (com require o driver pg emite aviso de depreciação).
# A UNPOOLED é usada só pelas migrations (prisma migrate deploy).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (upload) — lido implicitamente pelo `put()` do @vercel/blob.
BLOB_READ_WRITE_TOKEN=

# Origens permitidas pelo CORS, separadas por vírgula. Vazio = localhost:3000
# e localhost:5173. Em produção: https://seu-app.vercel.app
CORS_ORIGIN=

# Firebase Admin (JSON completo da service account). O login acontece no front,
# mas o FirebaseAuthGuard valida aqui os ID tokens recebidos — sem esta
# variável (ou FIREBASE_PROJECT_ID) a API nem sobe.
FIREBASE_SERVICE_ACCOUNT=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# REST do Payload (server-to-server; ex.: http://localhost:3000/api)
PAYLOAD_API_URL=http://localhost:3000/api

# Chave interna compartilhada com o admin do Payload (rotacionável)
INTERNAL_API_KEY=
