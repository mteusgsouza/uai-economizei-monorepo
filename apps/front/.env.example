# URL pública do site (robots.txt e sitemap.xml). Sem ela cai em localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL da API Nest — só server-side (admin do Payload e o proxy em app/(front)/bff).
# O browser nunca fala com a API diretamente; passa pelo /bff, que mascara esta URL.
API_URL=http://localhost:8080

# Chave interna compartilhada com a API Nest (server-only, nunca NEXT_PUBLIC)
INTERNAL_API_KEY=

# Postgres (Neon) usado pelo Payload CMS.
# Use sslmode=verify-full — com sslmode=require o driver pg emite aviso de
# depreciação, que o Next mostra no overlay como se fosse erro.
# Ex.: postgresql://user:senha@host/db?sslmode=verify-full&channel_binding=require
DATABASE_URL=

# Segredo do Payload (https://payloadcms.com/docs/getting-started/installation)
PAYLOAD_SECRET=

# Vercel Blob — obrigatório em produção (o filesystem da Vercel é efêmero).
# Sem o token os uploads da Media caem no `staticDir` local (só desenvolvimento).
BLOB_READ_WRITE_TOKEN=

# Anthropic (server-only) — gerador de sinônimos do admin e assistente de busca.
# Sem a chave, os recursos de IA ficam desligados e o resto do site funciona normal.
ANTHROPIC_API_KEY=
# Só para chave que não está vinculada a um workspace (a API devolve 400 pedindo o header).
ANTHROPIC_WORKSPACE_ID=
# DeepSeek (server-only) — alternativa à Anthropic pelo endpoint compatível.
# Se definida, tem prioridade sobre ANTHROPIC_API_KEY.
DEEPSEEK_API_KEY=
